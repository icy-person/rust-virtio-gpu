[Unit]
Description=Waydroid Mesa Venus vtest server
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/waydroid-venus --start
Restart=on-failure
RestartSec=1

# The vtest socket is intentionally shared with the Waydroid container.
# Adjust --rendernode/--host-icd in the installed command or wrapper when
# the host has multiple Vulkan devices.

[Install]
WantedBy=default.target
